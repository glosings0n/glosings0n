{
  "version": 2,
  "buildCommand": "mv index.html home.html",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/codelabs",
      "destination": "https://codelabs.glosings0n.dev/",
      "permanent": false
    },
    {
      "source": "/codelabs/",
      "destination": "https://codelabs.glosings0n.dev/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "codelabs.glosings0n.dev"
        }
      ],
      "destination": "/codelabs/hub"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/flutter-gemma-droidcon-ug-2026",
      "destination": "/codelabs/flutter-gemma-droidcon-ug-2026"
    },
    {
      "source": "/genkit-dart-agentic-workflows",
      "destination": "/codelabs/genkit-dart-agentic-workflows"
    },
    {
      "source": "/agentic-coding-flutter-mcp-skills",
      "destination": "/codelabs/agentic-coding-flutter-mcp-skills"
    },
    {
      "source": "/hybrid-ai-firebase-litert-flutter",
      "destination": "/codelabs/hybrid-ai-firebase-litert-flutter"
    },
    {
      "source": "/apps-script-workspace-automation",
      "destination": "/codelabs/apps-script-workspace-automation"
    },
    {
      "source": "/:slug([^/.]+)",
      "has": [
        {
          "type": "host",
          "value": "codelabs.glosings0n.dev"
        }
      ],
      "destination": "/codelabs/:slug"
    }
  ]
}
