{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/codelabs",
      "destination": "https://codelabs.glosings0n.dev/",
      "permanent": false
    },
    {
      "source": "/codelabs/",
      "destination": "https://codelabs.glosings0n.dev/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "codelabs.glosings0n.dev"
        }
      ],
      "destination": "/codelabs/hub"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/flutter-gemma-droidcon-ug-2026",
      "destination": "/codelabs/flutter-gemma-droidcon-ug-2026"
    },
    {
      "source": "/:slug([^/.]+)",
      "has": [
        {
          "type": "host",
          "value": "codelabs.glosings0n.dev"
        }
      ],
      "destination": "/codelabs/:slug"
    }
  ]
}
